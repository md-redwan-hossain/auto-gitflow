{
  "url": "https://git.demo.com/user/my-repo",
  "gitPlatform": "gitea",
  "steps": [
    {
      "type": "list-pr",
      "status": "open",
      "user": "redwan",
      "bypassEager": true,
    },
    {
      "eager": true,
      "subSteps": [
        {
          "type": "create-pr",
          "sourceBranch": "redwan",
          "destinationBranch": "develop",
          "mergeWhenChecksSucceed": "yes",
          "eager": true,
          "needConfirmation": true,
          "waitFor": ["develop-branch-docker.yaml"],
        },
        {
          "type": "merge-pr",
          "when": [
            {
              "destinationBranch": "develop",
              "waitFor": ["develop-branch-docker.yaml"],
            },
          ],
        },
      ],
    },
    {
      "type": "run-workflow",
      "workflow": "staging-deploy.yaml",
      "ref": "develop",
      "eager": true,
      "needConfirmation": true,
    },
    {
      "type": "create-pr",
      "sourceBranch": "develop",
      "destinationBranch": "main",
      "mergeWhenChecksSucceed": "yes",
      "waitFor": ["main-branch-docker.yaml"],
      "eager": true,
      "needConfirmation": true,
    },
    {
      "type": "run-workflow",
      "workflow": "production-deploy.yaml",
      "ref": "main",
      "eager": true,
    },
  ],
}
